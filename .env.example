# Environment Variables - Příklad konfigurace
# Zkopírujte tento soubor jako .env a vyplňte své údaje

# ============================================================================
# LinkedIn Credentials (volitelné)
# ============================================================================
# LinkedIn může vyžadovat autentizaci pro scraping
# Pokud nechcete scraping LinkedIn, ponechte prázdné nebo nastavte enabled: False v config.py

LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# ============================================================================
# Proxy nastavení (volitelné)
# ============================================================================
# Použijte pokud potřebujete routing přes proxy server

HTTP_PROXY=
HTTPS_PROXY=

# Příklady:
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=https://proxy.example.com:8080

# S autentizací:
# HTTP_PROXY=http://username:password@proxy.example.com:8080
# HTTPS_PROXY=https://username:password@proxy.example.com:8080

# ============================================================================
# POUŽITÍ
# ============================================================================

# Linux/Mac - načtení do shellu:
#   export $(cat .env | xargs)
#   python main.py

# Nebo použijte python-dotenv:
#   pip install python-dotenv
#   # V config.py přidejte na začátek:
#   from dotenv import load_dotenv
#   load_dotenv()

# Windows CMD:
#   for /f "tokens=*" %i in (.env) do set %i
#   python main.py

# Windows PowerShell:
#   Get-Content .env | ForEach-Object {
#       $name, $value = $_.split('=')
#       Set-Content env:\$name $value
#   }
#   python main.py

# ============================================================================
# BEZPEČNOST
# ============================================================================

# DŮLEŽITÉ:
# - Nikdy necommitujte .env soubor do gitu!
# - .env je v .gitignore
# - Používejte silná hesla
# - Zvažte použití password manageru nebo credential vaultu
# - Pro produkční nasazení použijte bezpečnější metody (AWS Secrets Manager, atd.)

# ============================================================================
