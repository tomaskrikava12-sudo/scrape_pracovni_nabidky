<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Název služby -->
    <key>Label</key>
    <string>cz.jobs.scraper</string>

    <!-- Cesta ke spouštěcímu skriptu - UPRAVTE PODLE VAŠÍ INSTALACE -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/VASE_UZIVATELSKE_JMENO/Documents/scrape_pracovni_nabidky/run_scraper.sh</string>
    </array>

    <!-- Pracovní adresář -->
    <key>WorkingDirectory</key>
    <string>/Users/VASE_UZIVATELSKE_JMENO/Documents/scrape_pracovni_nabidky</string>

    <!-- Časování - denně v 9:00 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Logování výstupu -->
    <key>StandardOutPath</key>
    <string>/Users/VASE_UZIVATELSKE_JMENO/Documents/scrape_pracovni_nabidky/launchd.log</string>

    <!-- Logování chyb -->
    <key>StandardErrorPath</key>
    <string>/Users/VASE_UZIVATELSKE_JMENO/Documents/scrape_pracovni_nabidky/launchd_error.log</string>

    <!-- Spustit i když nejsou připojené externí disky -->
    <key>RunAtLoad</key>
    <false/>

    <!-- Neomezovat resource usage -->
    <key>Nice</key>
    <integer>0</integer>

</dict>
</plist>
